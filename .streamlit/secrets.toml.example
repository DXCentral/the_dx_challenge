[app]
environment = "staging"
spreadsheet_id = "1Z0C_bnxCgVMWdhP26MbvKqsGCNcCab0zeSQiIpJzn2A"
writes_enabled = true

# Google login and Sheets service-account values are added only after the
# staging app has a stable URL. Never commit the real secrets.toml file.

[auth]
redirect_uri = "https://thedxchallenge.streamlit.app/oauth2callback"
cookie_secret = "REPLACE_WITH_A_LONG_RANDOM_VALUE"
client_id = "REPLACE_WITH_GOOGLE_OIDC_CLIENT_ID"
client_secret = "REPLACE_WITH_GOOGLE_OIDC_CLIENT_SECRET"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"

[gcp_service_account]
type = "service_account"
project_id = "REPLACE_FROM_JSON"
private_key_id = "REPLACE_FROM_JSON"
private_key = """-----BEGIN PRIVATE KEY-----
REPLACE_FROM_JSON
-----END PRIVATE KEY-----
"""
client_email = "REPLACE_FROM_JSON"
client_id = "REPLACE_FROM_JSON"
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "REPLACE_FROM_JSON"
